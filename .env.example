# Copy to `.env` and fill in. NEVER commit real credentials.
# Cisco Secure Network Analytics (SNA) Manager connection settings.

# Manager IP or hostname (with or without https://), e.g. sna-manager.example.com
SNA_HOST=sna-manager.example.com

# API user (same creds as the SNA web UI). Do not hardcode in source.
SNA_USERNAME=admin
SNA_PASSWORD=

# Optional: pin a specific tenant/domain id. If unset, the first one is used.
SNA_TENANT_ID=

# Lab appliances use a self-signed cert; leave false for lab, true for prod.
SNA_VERIFY_TLS=false

# Optional tuning.
SNA_TIMEOUT=30
SNA_POLL_INTERVAL=1
SNA_POLL_TIMEOUT=300

# --- ISE ANC module (optional) -------------------------------------------
# Only needed for the ise_anc_* tools (SNA-detect -> ISE-quarantine chain).
# Uses the ISE ERS API (TCP 9060, Basic auth with an ERS Admin account).
ISE_HOST=
ISE_USERNAME=
ISE_PASSWORD=
ISE_PORT=9060
ISE_VERIFY_TLS=false
# Mutating quarantine/clear actions are OFF unless set to true.
ISE_ENABLE_ANC_ACTIONS=false
